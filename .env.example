# Variables de entorno — FarmaImport, C.A.
# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se sube a GitHub.

# Project URL (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Publishable key (sb_publishable_...). La anon key heredada también sirve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Si usas la llave heredada, comenta la anterior y usa esta:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# IMPORTANTE: la secret key / service_role NUNCA va aquí ni en una
# variable NEXT_PUBLIC_. Se salta el RLS y da control total de la base.

# ----------------------------------------------------------------------------
# Punto extra: enviar la factura por correo (Resend)
# Opcional. Sin esta llave la app funciona igual; solo se desactiva el envío.
# Secreta: va en Vercel → Settings → Environment Variables, SIN NEXT_PUBLIC_.
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Con la cuenta gratuita de Resend usa onboarding@resend.dev
# hasta que verifiques tu propio dominio.
# EMAIL_FROM=FarmaImport <onboarding@resend.dev>

